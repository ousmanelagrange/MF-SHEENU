{
  "expo": {
    "name": "Sheenu",
    "slug": "sheenu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sheenu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2D5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.sheenu"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "sheenu",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Sheenu utilise vos photos pour les partager avec votre famille.",
          "cameraPermission": "Sheenu utilise l'appareil photo pour les photos de famille."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sheenu utilise le micro pour enregistrer les récits des anciens."
        }
      ]
    ]
  }
}
